{
  "name": "studiowire-io",
  "private": true,
  "version": "0.2.8.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "validate:project": "tsx tools/validate-project.ts",
    "validate:fixtures": "tsx tools/validate-fixtures.ts",
    "check:scale": "tsx tools/check-scale.ts",
    "summary": "tsx tools/print-project-summary.ts",
    "version:check": "node tools/check-version.mjs",
    "clean": "node tools/clean-generated.mjs",
    "clean:check": "node tools/check-clean.mjs",
    "package:source": "node tools/package-source.mjs",
    "check:scripts": "node tools/check-scripts.mjs",
    "check": "npm run check:scripts && npm run format:check && npm run lint && npm run typecheck && npm run build && npm run coverage && npm run validate:fixtures && npm run version:check && npm run clean && npm run clean:check",
    "check:release": "npm run check && npm run check:scale && npm run test:e2e:install && npm run test:e2e",
    "check:full": "npm run check:release && npm run package:source && npm run clean && npm run clean:check"
  },
  "files": [
    "AGENTS.md",
    "src",
    "docs",
    "schema",
    "tests",
    "tools",
    "index.html",
    "components.json",
    "postcss.config.js",
    "tailwind.config.js",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.cjs",
    ".gitignore",
    ".prettierrc.json",
    ".prettierignore"
  ],
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.40.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "18.19.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "jsdom": "^24.1.3",
    "jszip": "^3.10.1",
    "postcss": "8.4.49",
    "prettier": "3.6.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "vite": "6.4.2",
    "vitest": "3.2.4"
  }
}
