{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studiowire.local/schema/studiowire.device-template.schema.json",
  "title": "StudioWire IO Device Template v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["templateSchemaVersion", "templateType", "device", "ioInterfaces"],
  "properties": {
    "templateSchemaVersion": { "const": "0.1.0" },
    "templateType": { "const": "device" },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "subName", "manufacturer", "model", "categoryName", "rackSizeRu"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "subName": { "type": "string" },
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "categoryName": { "type": "string", "minLength": 1 },
        "rackSizeRu": {
          "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 48 }, { "type": "null" }]
        }
      }
    },
    "ioInterfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "direction",
          "categoryName",
          "connectorName",
          "count",
          "portLabelPattern",
          "color"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["input", "output", "bidirectional"] },
          "categoryName": { "type": "string", "minLength": 1 },
          "connectorName": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 },
          "portLabelPattern": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      }
    }
  }
}
