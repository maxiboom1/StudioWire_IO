{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studiowire.io/schema/studiowire.project.schema.json",
  "title": "StudioWire IO Project v0.2.8.19",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "settings",
    "locations",
    "subLocations",
    "racks",
    "devices",
    "portGroups",
    "ports",
    "cables",
    "numberingLedgers",
    "validationIssues",
    "changeLog"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2.8.19"
    },
    "project": {
      "$ref": "#/$defs/ProjectInfo"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Location"
      }
    },
    "subLocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SubLocation"
      }
    },
    "racks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rack"
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Device"
      }
    },
    "portGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PortGroup"
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Port"
      }
    },
    "cables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Cable"
      }
    },
    "numberingLedgers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NumberingLedger"
      }
    },
    "validationIssues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      }
    },
    "changeLog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChangeLogEntry"
      }
    }
  },
  "$defs": {
    "ProjectInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "customer",
        "revision",
        "status",
        "createdAt",
        "updatedAt",
        "createdBy",
        "updatedBy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "customer": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "status": {
          "enum": ["draft", "approved", "as_built"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        },
        "updatedBy": {
          "type": "string"
        }
      }
    },
    "Settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories",
        "connectorTypes",
        "categoryConnectorAssignments",
        "connectorCompatibilityGroups",
        "connectorCompatibilityGroupMembers",
        "cablePrefixes",
        "rackDefaults",
        "labelRules"
      ],
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Category"
          }
        },
        "connectorTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConnectorType"
          }
        },
        "categoryConnectorAssignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CategoryConnectorAssignment"
          }
        },
        "connectorCompatibilityGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConnectorCompatibilityGroup"
          }
        },
        "connectorCompatibilityGroupMembers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConnectorCompatibilityGroupMember"
          }
        },
        "cablePrefixes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CablePrefix"
          }
        },
        "rackDefaults": {
          "$ref": "#/$defs/RackDefaults"
        },
        "labelRules": {
          "$ref": "#/$defs/LabelRules"
        }
      }
    },
    "Category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "defaultCablePrefix", "color"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "defaultCablePrefix": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "ConnectorType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "iconKey"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "iconKey": {
          "$ref": "#/$defs/ConnectorIconKey"
        }
      }
    },
    "CategoryConnectorAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "categoryId", "connectorTypeId"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "categoryId": {
          "type": "string",
          "minLength": 1
        },
        "connectorTypeId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ConnectorCompatibilityGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "categoryId", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "categoryId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ConnectorCompatibilityGroupMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "groupId", "connectorTypeId"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "connectorTypeId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CablePrefix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prefix", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RackDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heightRu", "numberingDirection"],
      "properties": {
        "heightRu": {
          "type": "integer",
          "minimum": 1
        },
        "numberingDirection": {
          "$ref": "#/$defs/RackNumberingDirection"
        }
      }
    },
    "LabelRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cableNumberFormat", "cableNumberPadding"],
      "properties": {
        "cableNumberFormat": {
          "const": "PREFIX-0001"
        },
        "cableNumberPadding": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "description"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "SubLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locationId", "name", "description"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "Rack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locationId", "subLocationId", "name", "heightRu", "numberingDirection"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "subLocationId": {
          "type": ["string", "null"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "heightRu": {
          "type": "integer",
          "minimum": 1
        },
        "numberingDirection": {
          "$ref": "#/$defs/RackNumberingDirection"
        }
      }
    },
    "Device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "categoryId",
        "locationId",
        "subLocationId",
        "labelPrefix",
        "mountType",
        "rackId",
        "rackSizeRu",
        "rackBottomRu",
        "status",
        "notes",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/DeviceKind"
        },
        "code": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "categoryId": {
          "type": "string",
          "minLength": 1
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "subLocationId": {
          "type": ["string", "null"]
        },
        "role": {
          "type": "string"
        },
        "labelPrefix": {
          "type": "string"
        },
        "mountType": {
          "$ref": "#/$defs/DeviceMountType"
        },
        "rackId": {
          "type": ["string", "null"]
        },
        "rackSizeRu": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "rackBottomRu": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "status": {
          "enum": ["planned", "connected"]
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "device"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["code", "manufacturer", "model", "role"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "terminal_block"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "code": false,
              "manufacturer": false,
              "model": false,
              "role": false,
              "mountType": {
                "const": "rack"
              },
              "rackId": {
                "type": "string",
                "minLength": 1
              },
              "rackSizeRu": {
                "const": 1
              },
              "rackBottomRu": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mountType": {
                "enum": ["rack", "non_rack"]
              }
            },
            "required": ["mountType"]
          },
          "then": {
            "properties": {
              "locationId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "PortGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deviceId",
        "name",
        "direction",
        "categoryId",
        "connectorTypeId",
        "count",
        "portLabelPattern",
        "cablePrefix",
        "firstCableNumber",
        "lastCableNumber",
        "numberingRangeId",
        "createPlannedCables",
        "locked",
        "colorOverride"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "$ref": "#/$defs/PortDirection"
        },
        "categoryId": {
          "type": "string",
          "minLength": 1
        },
        "connectorTypeId": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "portLabelPattern": {
          "type": "string",
          "minLength": 1
        },
        "cablePrefix": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "firstCableNumber": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "lastCableNumber": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "numberingRangeId": {
          "type": ["string", "null"]
        },
        "createPlannedCables": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "colorOverride": {
          "type": ["string", "null"],
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "createPlannedCables": {
                "const": true
              }
            },
            "required": ["createPlannedCables"]
          },
          "then": {
            "properties": {
              "firstCableNumber": {
                "type": "integer",
                "minimum": 1
              },
              "lastCableNumber": {
                "type": "integer",
                "minimum": 1
              },
              "numberingRangeId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "firstCableNumber": {
                "const": null
              },
              "lastCableNumber": {
                "const": null
              },
              "numberingRangeId": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "Port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deviceId",
        "portGroupId",
        "index",
        "name",
        "label",
        "direction",
        "categoryId",
        "connectorTypeId",
        "plannedCableId",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "portGroupId": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/PortDirection"
        },
        "categoryId": {
          "type": "string",
          "minLength": 1
        },
        "connectorTypeId": {
          "type": "string",
          "minLength": 1
        },
        "plannedCableId": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "Cable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "prefix",
        "index",
        "status",
        "sideAEndpoint",
        "sideBEndpoint",
        "labelTop",
        "labelMiddle",
        "labelBottom",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{4,}$"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": ["planned", "connected", "retired"]
        },
        "sideAEndpoint": {
          "$ref": "#/$defs/Endpoint"
        },
        "sideBEndpoint": {
          "$ref": "#/$defs/Endpoint"
        },
        "labelTop": {
          "type": "string"
        },
        "labelMiddle": {
          "type": "string"
        },
        "labelBottom": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "NumberingLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "nextSuggested", "ranges"],
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "nextSuggested": {
          "type": "integer",
          "minimum": 1
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NumberingRange"
          }
        }
      }
    },
    "NumberingRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prefix", "from", "to", "status", "ownerType", "ownerId", "reason", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "from": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": ["allocated", "reserved_gap"]
        },
        "ownerType": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "label"],
      "properties": {
        "type": {
          "enum": ["device_port", "tb_port", "external", "unknown"]
        },
        "id": {
          "type": ["string", "null"]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "ValidationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "code", "message", "objectType", "objectId"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "objectType": {
          "type": "string"
        },
        "objectId": {
          "type": "string"
        }
      }
    },
    "ChangeLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timestamp", "message", "author"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "message": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "RackNumberingDirection": {
      "enum": ["bottom_to_top", "top_to_bottom"]
    },
    "ConnectorIconKey": {
      "enum": ["bnc", "xlr", "rj45", "fiber", "sfp", "hdmi", "db25", "generic"]
    },
    "DeviceMountType": {
      "enum": ["rack", "non_rack", "virtual"]
    },
    "DeviceKind": {
      "enum": ["device", "terminal_block"]
    },
    "PortDirection": {
      "enum": ["input", "output", "bidirectional", "rear", "front"]
    }
  }
}
